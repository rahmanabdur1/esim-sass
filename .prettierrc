{
  "semi":                 true,
  "singleQuote":          true,
  "trailingComma":        "all",
  "printWidth":           100,
  "tabWidth":             2,
  "useTabs":              false,
  "bracketSpacing":       true,
  "bracketSameLine":      false,
  "arrowParens":          "always",
  "endOfLine":            "lf",
  "plugins":              ["prettier-plugin-tailwindcss"],
  "tailwindConfig":       "./tailwind.config.ts",
  "overrides": [
    {
      "files": "*.json",
      "options": { "printWidth": 120 }
    },
    {
      "files": "*.md",
      "options": { "printWidth": 80, "proseWrap": "always" }
    }
  ]
}
