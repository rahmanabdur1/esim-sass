{
  "name": "esim-saas-platform",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "Enterprise eSIM SaaS Platform",
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false next lint",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "postinstall": "husky install || true"
  },
  "dependencies": {
    "@hookform/resolvers": "5.0.1",
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toast": "1.2.14",
    "@radix-ui/react-tooltip": "1.2.7",
    "@sentry/nextjs": "8.55.0",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-query-devtools": "5.80.7",
    "axios": "1.9.0",
    "class-variance-authority": "0.7.1",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "11.18.2",
    "import-in-the-middle": "1.15.0",
    "lucide-react": "0.511.0",
    "next": "15.5.22",
    "next-themes": "0.4.6",
    "qrcode.react": "4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.57.0",
    "react-hot-toast": "2.5.2",
    "react-intersection-observer": "9.16.0",
    "recharts": "3.10.1",
    "require-in-the-middle": "7.5.2",
    "server-only": "0.0.1",
    "sharp": "0.33.5",
    "tailwind-merge": "3.3.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "web-vitals": "4.2.4",
    "zod": "3.25.64",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "29.7.0",
    "@next/bundle-analyzer": "16.2.12",
    "@playwright/test": "1.52.0",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-viewport": "8.6.18",
    "@storybook/nextjs": "8.6.18",
    "@storybook/react": "8.6.18",
    "@svgr/webpack": "8.1.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.34.0",
    "@typescript-eslint/parser": "8.34.0",
    "autoprefixer": "10.4.21",
    "axe-core": "4.10.3",
    "cross-env": "7.0.3",
    "eslint": "9.28.0",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-axe": "9.0.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.5.2",
    "postcss": "8.5.4",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.12",
    "storybook": "8.6.18",
    "wait-on": "8.0.3"
  },
  "pnpm": {
    "overrides": {
      "import-in-the-middle": "1.15.0",
      "require-in-the-middle": "7.5.2"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
